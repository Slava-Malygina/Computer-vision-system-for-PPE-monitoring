QPushButton {
    background-color: #282650;
    color: #ffffff;
    border: 1px solid #2a68ff;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #3a424e;
    border-color: #3a7fff;
}

QPushButton:pressed {
    background-color: #1a1f25;
}

QPushButton:disabled {
    background-color: #1a1f25;
    color: #5a6370;
    border-color: #2a2e35;
}

QPushButton.primary {
    background-color: #3a7fff;
    border-color: #3a7fff;
}

QPushButton.primary:hover {
    background-color: #5a8fff;
}

QPushButton.success {
    background-color: #27ae60;
    border-color: #27ae60;
}

QPushButton.success:hover {
    background-color: #2ecc71;
}

QPushButton.danger {
    background-color: #e74c3c;
    border-color: #e74c3c;
}

QPushButton.danger:hover {
    background-color: #ec7063;
}