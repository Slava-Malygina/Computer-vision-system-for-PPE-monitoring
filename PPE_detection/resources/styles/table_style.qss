QHeaderView {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(230, 119, 255, 128),
        stop: 0.5 rgba(124, 121, 252, 128),
        stop: 1 rgba(125, 207, 255, 128)
    );
    min-height: 30px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QHeaderView::section {
    background: transparent;
    color: white;
    font-weight: bold;
    padding: 10px;
    border: none;
}

QTableWidget::item {
    background-color: #323055;
    padding: 6px;
    color: white;
    border-bottom: 1px solid #2a2e35;
    padding-right: 20px;
}

QTableWidget {
    border: none;
    background-color: transparent;
    alternate-background-color: #323055;
    gridline-color: #000000;
    selection-background-color: #5D4981;
     border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTableWidget QScrollBar::sub-line:vertical,
QTableWidget QScrollBar::add-line:vertical {
    height: 0px;
    background: none;
}

QTableWidget QScrollBar:vertical {
    background: transparent;
    width: 15px;
    margin: 15px 0px 15px 0px;
    border-radius: 4px;
}

QTableWidget QScrollBar::groove:vertical {
    background: transparent;
    border-radius: 4px;
}

QTableWidget QScrollBar::handle:vertical {
    background: #201E36;
    border-radius: 4px;
    min-height: 30px;
    margin-left: 7px;
}

QTableWidget QScrollBar::handle:vertical:hover {
    background: #323055;
}
QHeaderView::section:first {
    border-top-left-radius: 10px;
}

QHeaderView::section:last {
    border-top-right-radius: 10px;
}

QTableWidget QScrollBar::add-page:vertical,
QTableWidget QScrollBar::sub-page:vertical {
    background: none;
}